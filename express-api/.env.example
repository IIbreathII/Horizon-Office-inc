NODE_ENV=development
PORT=3000

# Подключение к AWS RDS PostgreSQL.
# Формат: postgresql://<user>:<password>@<endpoint>:5432/<db_name>?schema=public&sslmode=require&sslaccept=accept_invalid_certs
# Спецсимволы в пароле экранировать: @ → %40, : → %3A, / → %2F, # → %23, % → %25
DATABASE_URL=postgresql://postgres:PASSWORD@your-db.xxxxxxxxxxxx.eu-central-1.rds.amazonaws.com:5432/postgres?schema=public&sslmode=require&sslaccept=accept_invalid_certs

# Секрет для проверки JWT — тот же, что в auth-API (минимум 32 символа)
JWT_SECRET=
JWT_ISSUER=auth-api
JWT_AUDIENCE=volunteer-api

# Dev-байпас guard: работает только при IS_DEVELOPMENT=true.
# Authorization: Bearer <DEV_BYPASS_TOKEN> проходит auth без JWT.
IS_DEVELOPMENT=false
DEV_BYPASS_TOKEN=
