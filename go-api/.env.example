# auth-API: реєстрація, вхід і видача JWT для express-api.
PORT=8080
DATABASE_URL=postgresql://<user>:<password>@localhost:5433/postgres?sslmode=require

# Мають збігатися з express-api/.env — там перевіряються підпис, iss і aud токенів.
JWT_SECRET=
JWT_ISSUER=auth-api
JWT_AUDIENCE=volunteer-api

# Google Identity Services: Client ID з Google Cloud Console (Client Secret не потрібен).
# Порожній — вхід через Google вимкнено.
CLIENT_ID=

# Звідки браузер може ходити напряму, через кому. З проксі Next (/auth) не потрібно.
CORS_ORIGINS=http://localhost:3001
