# Скопіюйте в .env і заповніть.

# express-api через проксі Next (/api → API_URL, за замовчуванням http://localhost:3000)
NEXT_PUBLIC_API_URL=/api
# Адреса express-api для цього проксі. На сервері вшивається під час збирання образу
API_URL=http://localhost:3000

# go-api: вхід і реєстрація (викликають серверні обробники app/auth/*/route.ts)
AUTH_API_URL=http://localhost:8080

# Client ID з Google Cloud Console — той самий, що CLIENT_ID у go-api/.env
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Перевірка сесії в proxy.ts (лише сервер). Однакові з express-api/.env і go-api/.env
JWT_SECRET=
JWT_ISSUER=auth-api
JWT_AUDIENCE=volunteer-api

# Лише для розробки: вхід без логіну через DEV_BYPASS_TOKEN express-api
# NEXT_PUBLIC_API_TOKEN=
